# Скопируйте через `make secrets` — значения генерируются случайно. Реальные секреты в git не кладём.
ENV=demo
POSTGRES_PASSWORD=
APP_RW_PASSWORD=
SESSION_SECRET=
HMAC_KEY=
WM_KEY=
FERNET_KEY=

# Адрес, с которого открывается стенд (проверка Origin для CSRF): https://IP-или-домен[:порт], без слеша на конце
PUBLIC_ORIGIN=https://localhost:8443
# Swagger на демо-стенде за basic auth (по умолчанию выключен)
ENABLE_DOCS=false
