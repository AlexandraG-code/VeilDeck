{
  "components": {
    "schemas": {
      "AccessRequestIn": {
        "additionalProperties": false,
        "description": "Форма запроса расширенного доступа (SR-17: лишние поля, status и card_id в теле отвергаются).",
        "properties": {
          "consent": {
            "const": true,
            "title": "Consent",
            "type": "boolean"
          },
          "display_name": {
            "maxLength": 60,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "purpose": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          },
          "website": {
            "default": "",
            "maxLength": 200,
            "title": "Website",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "purpose",
          "consent"
        ],
        "title": "AccessRequestIn",
        "type": "object"
      },
      "AccessRequestOut": {
        "additionalProperties": false,
        "description": "Единый ответ на отправку: не зависит от исхода (SR-23, T-02).",
        "properties": {
          "status": {
            "const": "received",
            "default": "received",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "AccessRequestOut",
        "type": "object"
      },
      "CardCreateIn": {
        "additionalProperties": false,
        "description": "Создание черновика. id, status, created_by и published_at сюда не входят: лишнее поле даёт 422 (TC-API-02).",
        "properties": {
          "deal_type": {
            "$ref": "#/components/schemas/DealType"
          },
          "full_description": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Full Description",
            "type": "string"
          },
          "industry": {
            "$ref": "#/components/schemas/Industry"
          },
          "org_aliases": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Org Aliases",
            "type": "array"
          },
          "org_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Org Name",
            "type": "string"
          },
          "region_macro": {
            "$ref": "#/components/schemas/RegionMacro"
          },
          "revenue_band": {
            "$ref": "#/components/schemas/RevenueBand"
          },
          "size_band": {
            "$ref": "#/components/schemas/SizeBand"
          },
          "teaser_text": {
            "maxLength": 600,
            "minLength": 1,
            "title": "Teaser Text",
            "type": "string"
          },
          "title_generic": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Title Generic",
            "type": "string"
          }
        },
        "required": [
          "title_generic",
          "industry",
          "region_macro",
          "size_band",
          "revenue_band",
          "deal_type",
          "teaser_text",
          "org_name",
          "full_description"
        ],
        "title": "CardCreateIn",
        "type": "object"
      },
      "CardFull": {
        "additionalProperties": false,
        "description": "Полная карточка для staff: включает конфиденциальные поля, наружу публичному API не отдаётся.",
        "properties": {
          "created_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created By"
          },
          "deal_type": {
            "$ref": "#/components/schemas/DealType"
          },
          "full_description": {
            "title": "Full Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "$ref": "#/components/schemas/Industry"
          },
          "org_aliases": {
            "items": {
              "type": "string"
            },
            "title": "Org Aliases",
            "type": "array"
          },
          "org_name": {
            "title": "Org Name",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "region_macro": {
            "$ref": "#/components/schemas/RegionMacro"
          },
          "revenue_band": {
            "$ref": "#/components/schemas/RevenueBand"
          },
          "size_band": {
            "$ref": "#/components/schemas/SizeBand"
          },
          "status": {
            "$ref": "#/components/schemas/CardStatus"
          },
          "teaser_text": {
            "title": "Teaser Text",
            "type": "string"
          },
          "title_generic": {
            "title": "Title Generic",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "title_generic",
          "industry",
          "region_macro",
          "size_band",
          "revenue_band",
          "deal_type",
          "teaser_text",
          "org_name",
          "org_aliases",
          "full_description",
          "created_by",
          "published_at"
        ],
        "title": "CardFull",
        "type": "object"
      },
      "CardStatus": {
        "description": "Состояния жизненного цикла.",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "title": "CardStatus",
        "type": "string"
      },
      "CatalogPage": {
        "additionalProperties": false,
        "description": "Количество относится только к опубликованным карточкам.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TeaserCard"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "CatalogPage",
        "type": "object"
      },
      "CsrfOut": {
        "additionalProperties": false,
        "description": "Токен для заголовка X-CSRF-Token.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut",
        "type": "object"
      },
      "DealType": {
        "description": "Типы корпоративных возможностей.",
        "enum": [
          "equity",
          "asset",
          "partnership"
        ],
        "title": "DealType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Ответ /healthz.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Industry": {
        "description": "Обобщённые отрасли.",
        "enum": [
          "manufacturing",
          "logistics",
          "technology",
          "services"
        ],
        "title": "Industry",
        "type": "string"
      },
      "LoginIn": {
        "additionalProperties": false,
        "description": "Вход сотрудника: e-mail, пароль и обязательный TOTP-код.",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "totp": {
            "pattern": "^[0-9]{6}$",
            "title": "Totp",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "totp"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "LoginOut": {
        "additionalProperties": false,
        "description": "Ответ входа: CSRF-токен для заголовка X-CSRF-Token и роль для интерфейса.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "role"
        ],
        "title": "LoginOut",
        "type": "object"
      },
      "MeOut": {
        "additionalProperties": false,
        "description": "Текущий сотрудник из серверной сессии.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "csrf_token"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RegionMacro": {
        "description": "Макрорегионы без адреса или города.",
        "enum": [
          "europe",
          "asia",
          "middle_east",
          "other"
        ],
        "title": "RegionMacro",
        "type": "string"
      },
      "RevenueBand": {
        "description": "Обобщённые диапазоны годовой выручки в EUR.",
        "enum": [
          "under_10m",
          "10m_to_50m",
          "50m_plus"
        ],
        "title": "RevenueBand",
        "type": "string"
      },
      "SizeBand": {
        "description": "Диапазоны численности сотрудников.",
        "enum": [
          "under_50",
          "50_to_249",
          "250_plus"
        ],
        "title": "SizeBand",
        "type": "string"
      },
      "TeaserCard": {
        "additionalProperties": false,
        "description": "Allowlist публичных полей; закрытых данных нет даже в SQL-проекции (T-02).",
        "properties": {
          "deal_type": {
            "$ref": "#/components/schemas/DealType"
          },
          "id": {
            "format": "uuid4",
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "$ref": "#/components/schemas/Industry"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "region_macro": {
            "$ref": "#/components/schemas/RegionMacro"
          },
          "revenue_band": {
            "$ref": "#/components/schemas/RevenueBand"
          },
          "size_band": {
            "$ref": "#/components/schemas/SizeBand"
          },
          "teaser_text": {
            "title": "Teaser Text",
            "type": "string"
          },
          "title_generic": {
            "title": "Title Generic",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title_generic",
          "industry",
          "region_macro",
          "size_band",
          "revenue_band",
          "deal_type",
          "teaser_text",
          "published_at"
        ],
        "title": "TeaserCard",
        "type": "object"
      },
      "TeaserLeakError": {
        "additionalProperties": false,
        "description": "Обёртка единого формата ошибки (для OpenAPI).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/TeaserLeakErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "TeaserLeakError",
        "type": "object"
      },
      "TeaserLeakErrorBody": {
        "additionalProperties": false,
        "description": "Тело ошибки 422 teaser_leak (для OpenAPI).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "violations": {
            "items": {
              "$ref": "#/components/schemas/ViolationOut"
            },
            "title": "Violations",
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "request_id",
          "violations"
        ],
        "title": "TeaserLeakErrorBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ViolationOut": {
        "additionalProperties": false,
        "description": "Нарушение линтера утечек: только код вида и имя поля, без фрагментов текста.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "code",
          "field"
        ],
        "title": "ViolationOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Значение из cookie __Host-csrf",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "VeilDeck API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cards": {
      "get": {
        "description": "Список опубликованных карточек: фильтры enum и не более 20 записей на страницу.",
        "operationId": "listCatalogCards",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 100000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 20,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "industry",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Industry"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Industry"
            }
          },
          {
            "in": "query",
            "name": "region_macro",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RegionMacro"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region Macro"
            }
          },
          {
            "in": "query",
            "name": "deal_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/DealType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Deal Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Cards",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/cards/{card_id}": {
      "get": {
        "description": "Одинаковый 404 для неверного UUID, черновика, архива и отсутствующей карточки.",
        "operationId": "getCatalogCard",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeaserCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Card",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/cards/{card_id}/access-requests": {
      "post": {
        "description": "Анонимная форма: ответ одинаков для новой карточки, дубля, неопубликованной карточки и honeypot.",
        "operationId": "createAccessRequest",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequestIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create Access Request",
        "tags": [
          "requests"
        ]
      }
    },
    "/api/v1/csrf": {
      "get": {
        "description": "Выдаёт токен и ставит cookie __Host-csrf: нужен до входа (login тоже проверяется).",
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Issue Csrf",
        "tags": [
          "csrf"
        ]
      }
    },
    "/api/v1/staff/auth/login": {
      "post": {
        "description": "Пароль + TOTP → новая сессия; присланный до входа SID удаляется (защита от фиксации, TC-AUTH-05).",
        "operationId": "staffLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/staff/auth/logout": {
      "post": {
        "description": "Удаляет сессию на сервере и затирает cookie (TC-AUTH-04).",
        "operationId": "staffLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/staff/auth/me": {
      "get": {
        "description": "Текущий сотрудник и CSRF-токен его сессии (нужен Swagger/SPA после перезагрузки страницы).",
        "operationId": "staffMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/staff/cards": {
      "post": {
        "description": "Создаёт черновик карточки (admin).",
        "operationId": "createCard",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardCreateIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardFull"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
