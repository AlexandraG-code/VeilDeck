{
  "components": {
    "schemas": {
      "CatalogPage": {
        "additionalProperties": false,
        "description": "Количество относится только к опубликованным карточкам.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TeaserCard"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "CatalogPage",
        "type": "object"
      },
      "CsrfOut": {
        "additionalProperties": false,
        "description": "Токен для заголовка X-CSRF-Token.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut",
        "type": "object"
      },
      "DealType": {
        "description": "Типы корпоративных возможностей.",
        "enum": [
          "equity",
          "asset",
          "partnership"
        ],
        "title": "DealType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Ответ /healthz.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Industry": {
        "description": "Обобщённые отрасли.",
        "enum": [
          "manufacturing",
          "logistics",
          "technology",
          "services"
        ],
        "title": "Industry",
        "type": "string"
      },
      "LoginIn": {
        "additionalProperties": false,
        "description": "Вход сотрудника: e-mail, пароль и обязательный TOTP-код.",
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "totp": {
            "pattern": "^[0-9]{6}$",
            "title": "Totp",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "totp"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "LoginOut": {
        "additionalProperties": false,
        "description": "Ответ входа: CSRF-токен для заголовка X-CSRF-Token и роль для интерфейса.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "csrf_token",
          "role"
        ],
        "title": "LoginOut",
        "type": "object"
      },
      "MeOut": {
        "additionalProperties": false,
        "description": "Текущий сотрудник из серверной сессии.",
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "csrf_token"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RegionMacro": {
        "description": "Макрорегионы без адреса или города.",
        "enum": [
          "europe",
          "asia",
          "middle_east",
          "other"
        ],
        "title": "RegionMacro",
        "type": "string"
      },
      "RevenueBand": {
        "description": "Обобщённые диапазоны годовой выручки в EUR.",
        "enum": [
          "under_10m",
          "10m_to_50m",
          "50m_plus"
        ],
        "title": "RevenueBand",
        "type": "string"
      },
      "SizeBand": {
        "description": "Диапазоны численности сотрудников.",
        "enum": [
          "under_50",
          "50_to_249",
          "250_plus"
        ],
        "title": "SizeBand",
        "type": "string"
      },
      "TeaserCard": {
        "additionalProperties": false,
        "description": "Allowlist публичных полей; закрытых данных нет даже в SQL-проекции (T-02).",
        "properties": {
          "deal_type": {
            "$ref": "#/components/schemas/DealType"
          },
          "id": {
            "format": "uuid4",
            "title": "Id",
            "type": "string"
          },
          "industry": {
            "$ref": "#/components/schemas/Industry"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "region_macro": {
            "$ref": "#/components/schemas/RegionMacro"
          },
          "revenue_band": {
            "$ref": "#/components/schemas/RevenueBand"
          },
          "size_band": {
            "$ref": "#/components/schemas/SizeBand"
          },
          "teaser_text": {
            "title": "Teaser Text",
            "type": "string"
          },
          "title_generic": {
            "title": "Title Generic",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title_generic",
          "industry",
          "region_macro",
          "size_band",
          "revenue_band",
          "deal_type",
          "teaser_text",
          "published_at"
        ],
        "title": "TeaserCard",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Значение из cookie __Host-csrf",
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "VeilDeck API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/cards": {
      "get": {
        "description": "Список опубликованных карточек: фильтры enum и не более 20 записей на страницу.",
        "operationId": "listCatalogCards",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 100000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 20,
              "minimum": 1,
              "title": "Page Size",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "industry",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Industry"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Industry"
            }
          },
          {
            "in": "query",
            "name": "region_macro",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RegionMacro"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Region Macro"
            }
          },
          {
            "in": "query",
            "name": "deal_type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/DealType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Deal Type"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "List Cards",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/cards/{card_id}": {
      "get": {
        "description": "Одинаковый 404 для неверного UUID, черновика, архива и отсутствующей карточки.",
        "operationId": "getCatalogCard",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeaserCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Get Card",
        "tags": [
          "catalog"
        ]
      }
    },
    "/api/v1/csrf": {
      "get": {
        "description": "Выдаёт токен и ставит cookie __Host-csrf: нужен до входа (login тоже проверяется).",
        "operationId": "getCsrfToken",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Issue Csrf",
        "tags": [
          "csrf"
        ]
      }
    },
    "/api/v1/staff/auth/login": {
      "post": {
        "description": "Пароль + TOTP → новая сессия; присланный до входа SID удаляется (защита от фиксации, TC-AUTH-05).",
        "operationId": "staffLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/staff/auth/logout": {
      "post": {
        "description": "Удаляет сессию на сервере и затирает cookie (TC-AUTH-04).",
        "operationId": "staffLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/staff/auth/me": {
      "get": {
        "description": "Текущий сотрудник и CSRF-токен его сессии (нужен Swagger/SPA после перезагрузки страницы).",
        "operationId": "staffMe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Возвращает признак живости процесса, без обращения к БД.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    }
  }
}
