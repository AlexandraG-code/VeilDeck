{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "importOrder": ["^react", "<THIRD_PARTY_MODULES>", "^@(app|pages|widgets|features|entities|shared|api)/", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
